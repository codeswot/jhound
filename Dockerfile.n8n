FROM node:22-bookworm-slim

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_ROOT_USER_ACTION=ignore \
    N8N_USER_FOLDER=/home/node/.n8n \
    NODE_ENV=production

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        build-essential python3-dev libffi-dev \
        libpq-dev libxml2-dev libxslt1-dev \
        curl ca-certificates tini git wget \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/local/bin/python

RUN npm install -g --omit=dev n8n@latest \
    && npm cache clean --force

COPY scripts/scrapers/requirements.txt   /tmp/req-scrapers.txt
COPY scripts/ai/requirements.txt         /tmp/req-ai.txt
COPY scripts/automation/requirements.txt /tmp/req-automation.txt
RUN pip3 install --no-cache-dir \
        -r /tmp/req-scrapers.txt \
        -r /tmp/req-ai.txt \
        -r /tmp/req-automation.txt \
    && rm -f /tmp/req-*.txt

COPY scripts/package.json /opt/jhound-node-modules/package.json
RUN cd /opt/jhound-node-modules \
    && npm install --omit=dev --loglevel=warn \
    && chown -R node:node /opt/jhound-node-modules
ENV NODE_PATH=/opt/jhound-node-modules/node_modules

RUN mkdir -p /home/node/.n8n /home/node/scripts /home/node/workflows /home/node/data /home/node/resources /home/node/tests \
    && chown -R node:node /home/node

COPY scripts/docker-entrypoint.sh /usr/local/bin/jhound-entrypoint.sh
RUN chmod +x /usr/local/bin/jhound-entrypoint.sh

USER node
WORKDIR /home/node

EXPOSE 5678
ENTRYPOINT ["tini", "--", "/usr/local/bin/jhound-entrypoint.sh"]
